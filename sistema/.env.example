# Configuracao do sistema. O instalar.sh cria este arquivo pra voce e sorteia
# as senhas automaticas - normalmente voce so precisa mexer aqui depois, para
# trocar alguma coisa.
#
# Para editar na VPS:  nano .env       (salva com Ctrl+O, sai com Ctrl+X)
# Depois de editar:    docker compose restart app

# ---------------------------------------------------------------------------
# 1) Endereco do CRM  (OBRIGATORIO)
# ---------------------------------------------------------------------------
# O endereco que voce vai digitar no navegador pra abrir o CRM.
#
# Se voce tem um dominio: aponte um subdominio (ex.: crm.suaempresa.com.br) para
# o IP da VPS no seu provedor de dominio e escreva ele aqui.
#
# Se voce NAO tem dominio: use o IP da VPS seguido de .sslip.io
#   Exemplo: IP 203.0.113.10  ->  DOMINIO=203.0.113.10.sslip.io
# Funciona igual e o certificado de seguranca sai automatico.
DOMINIO=

# E-mail usado so para avisos sobre o certificado de seguranca.
EMAIL_CERTIFICADO=

# ---------------------------------------------------------------------------
# 2) Chave da IA  (OBRIGATORIO)
# ---------------------------------------------------------------------------
# Crie em https://console.anthropic.com -> API Keys. O consumo e cobrado no seu
# cartao, direto pela Anthropic. Comece com uns US$5 de credito pra testar.
ANTHROPIC_API_KEY=

# Modelo usado no atendimento. O padrao e o mais rapido e barato.
# Troque para claude-sonnet-5 se o seu funil for complexo e valer o custo maior.
LLM_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# 3) Entender audios  (RECOMENDADO — nao e obrigatorio)
# ---------------------------------------------------------------------------
# No Brasil boa parte dos clientes manda audio em vez de escrever. Com esta chave,
# a atendente ouve o audio e responde normalmente.
#
# SEM a chave o sistema continua funcionando: ela pede com educacao que a pessoa
# escreva. Voce pode deixar em branco agora e preencher depois.
#
# Crie em https://platform.openai.com/api-keys (custa centavos por audio).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 4) Acesso ao CRM  (OBRIGATORIO)
# ---------------------------------------------------------------------------
# Voce vai usar isto pra entrar no CRM. Como ele fica na internet, use uma senha
# longa de verdade - nao repita a senha de outro lugar.
CRM_EMAIL=
CRM_PASSWORD=

# ---------------------------------------------------------------------------
# 5) Senhas internas  (o instalar.sh sorteia — nao precisa mexer)
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 6) Opcionais
# ---------------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo

# Onde fica o arquivo do banco. Nao precisa mexer: em branco, o sistema usa
# sistema/dados/crm.db. E um arquivo so - copiar ele e' o backup.
# DATABASE_URL=file:../dados/crm.db
